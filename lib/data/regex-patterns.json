    }
  },
  {
    "id": "whitespace-trim",
    "name": "공백 제거",
    "pattern": "^\\s+|\\s+$",
    "flags": "g",
    "description": "문자열 앞뒤 공백을 제거합니다.",
    "category": "extraction",
    "complexity": "basic",
    "examples": {
      "valid": [
        "  text  ",
        "\\ntext\\n",
        "\\ttext\\t"
      ],
      "invalid": [
        "text",
        "nowhitespace"
      ]
    },
    "usage": {
      "javascript": "const regex = /^\\s+|\\s+$/g;\nconst trimmed = text.replace(regex, '');",
      "java": "Pattern pattern = Pattern.compile(\"^\\\\s+|\\\\s+$\");\nString trimmed = pattern.matcher(text).replaceAll(\"\");"
    }
  },
