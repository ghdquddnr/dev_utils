  {
    "id": "html-tag",
    "name": "HTML 태그",
    "pattern": "<\\/?[a-z][a-z0-9]*\\b[^>]*>",
    "flags": "gi",
    "description": "HTML 태그를 추출합니다.",
    "category": "extraction",
    "complexity": "intermediate",
    "examples": {
      "valid": [
        "<div>",
        "<p class=\"text\">",
        "</div>",
        "<img src=\"image.jpg\" />"
      ],
      "invalid": [
        "< div>",
        "<123>",
        "div>"
      ]
    },
    "usage": {
      "javascript": "const regex = /<\\/?[a-z][a-z0-9]*\\b[^>]*>/gi;\nconst matches = text.match(regex);",
      "java": "Pattern pattern = Pattern.compile(\"<\\\\/?[a-z][a-z0-9]*\\\\b[^>]*>\", Pattern.CASE_INSENSITIVE);\nMatcher matcher = pattern.matcher(text);\nwhile (matcher.find()) { /* ... */ }"
    }
  },
