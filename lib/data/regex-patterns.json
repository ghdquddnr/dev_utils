  {
    "id": "credit-card",
    "name": "신용카드 번호",
    "pattern": "^(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|6(?:011|5[0-9]{2})[0-9]{12}|(?:2131|1800|35\\d{3})\\d{11})$",
    "flags": "",
    "description": "주요 신용카드 (Visa, MasterCard, Amex, Discover, Diners, JCB) 번호를 검증합니다.",
    "category": "validation",
    "complexity": "advanced",
    "examples": {
      "valid": [
        "4111111111111111",
        "5500000000000004",
        "340000000000009"
      ],
      "invalid": [
        "1234567890123456",
        "4111-1111-1111-1111",
        "411111111111111"
      ]
    },
    "usage": {
      "javascript": "const regex = /^(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|6(?:011|5[0-9]{2})[0-9]{12}|(?:2131|1800|35\\d{3})\\d{11})$/;\nconst isValid = regex.test('4111111111111111');",
      "java": "Pattern pattern = Pattern.compile(\"^(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|6(?:011|5[0-9]{2})[0-9]{12}|(?:2131|1800|35\\\\d{3})\\\\d{11})$\");\nboolean isValid = pattern.matcher(\"4111111111111111\").matches();"
    }
  },
